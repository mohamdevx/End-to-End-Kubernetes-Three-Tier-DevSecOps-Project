pipeline {
    agent any
    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        GCP_PROJECT_ID   = credentials('GCP_PROJECT_ID')
        AR_LOCATION      = credentials('AR_LOCATION')
        AR_REPO          = credentials('AR_REPO')
        IMAGE_NAME       = 'backend'
        AR_IMAGE         = "${AR_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}/${IMAGE_NAME}"
        GIT_REPO         = 'https://github.com/mohamdevx/End-to-End-Kubernetes-Three-Tier-DevSecOps-Project.git'
        GIT_BRANCH       = 'project-polish'
        GIT_USER         = 'mohamdevx'
        GIT_EMAIL        = 'mbalyallpuri@gmail.com'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO}", credentialsId: 'github-creds'
            }
        }
        stage('Trivy FS Scan') {
            steps {
                dir('Application-Code/backend') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('Application-Code/backend') {
                    sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
                }
            }
        }
        stage('Push to Artifact Registry') {
            steps {
                sh '''
                    gcloud auth configure-docker ${AR_LOCATION}-docker.pkg.dev --quiet
                    docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${AR_IMAGE}:${BUILD_NUMBER}
                    docker push ${AR_IMAGE}:${BUILD_NUMBER}
                '''
            }
        }
        stage('Trivy Image Scan') {
            steps {
                sh "trivy image ${AR_IMAGE}:${BUILD_NUMBER} > trivyimage.txt"
            }
        }
        stage('Update Manifest & Push') {
            steps {
                dir('Kubernetes-Manifests-file/Backend') {
                    withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'TOKEN')]) {
                        sh '''
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER}"
                            sed -i "s|image:.*|image: ${AR_IMAGE}:${BUILD_NUMBER}|" deployment.yaml
                            git add deployment.yaml
                            git commit -m "Update backend image to ${BUILD_NUMBER} [ci skip]" || true
                            git push https://${TOKEN}@github.com/${GIT_USER}/End-to-End-Kubernetes-Three-Tier-DevSecOps-Project.git HEAD:${GIT_BRANCH}
                        '''
                    }
                }
            }
        }
    }
}
